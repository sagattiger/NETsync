{
  "version": "1.23.13",
  "notificationList": [
    {"id": 1, "name": "Ops Telegram", "active": 1, "isDefault": 1, "userId": 1,
     "config": "{\"name\":\"Ops Telegram\",\"type\":\"telegram\",\"telegramBotToken\":\"123456:SECRET-BOT-TOKEN\",\"telegramChatID\":\"-100200300\"}"},
    {"id": 2, "name": "Mail", "active": 1, "isDefault": 0, "userId": 1,
     "config": "{\"name\":\"Mail\",\"type\":\"smtp\",\"smtpHost\":\"smtp.example.com\",\"smtpPassword\":\"SECRET-SMTP-PW\"}"}
  ],
  "monitorList": [
    {"id": 1, "name": "Website", "type": "http", "url": "https://www.example.com/", "method": "GET",
     "interval": 60, "retryInterval": 30, "maxretries": 2, "timeout": 48, "upsideDown": false, "active": true,
     "ignoreTls": false, "maxredirects": 10, "accepted_statuscodes": ["200-299", "301"], "expiryNotification": true,
     "headers": "{\"X-Api-Key\": \"SECRET-HEADER\"}", "body": null, "authMethod": null,
     "tags": [{"name": "web", "value": "", "color": "#2563eb"}, {"name": "env", "value": "prod"}],
     "description": "Public site", "notificationIDList": {"1": true}},
    {"id": 2, "name": "Status keyword", "type": "keyword", "url": "http://status.example.com", "method": "GET",
     "interval": 120, "maxretries": 0, "keyword": "Operational", "invertKeyword": false, "active": true,
     "accepted_statuscodes": ["200-299"], "authMethod": "basic", "basic_auth_user": "monitor",
     "basic_auth_pass": "SECRET-BASIC"},
    {"id": 3, "name": "No errors", "type": "keyword", "url": "https://app.example.com/log", "method": "GET",
     "interval": 60, "maxretries": 1, "keyword": "ERROR", "invertKeyword": true, "active": false,
     "accepted_statuscodes": ["200-299"]},
    {"id": 4, "name": "API health", "type": "json-query", "url": "https://api.example.com/health", "method": "POST",
     "interval": 30, "maxretries": 0, "jsonPath": "data.status", "expectedValue": "ok", "active": true,
     "body": "{\"ping\": true}", "httpBodyEncoding": "json", "accepted_statuscodes": ["200-299"]},
    {"id": 5, "name": "API JSONata", "type": "json-query", "url": "https://api.example.com/x", "method": "GET",
     "interval": 30, "jsonPath": "$count(items[status='down'])", "expectedValue": "0", "active": true,
     "accepted_statuscodes": ["200-299"]},
    {"id": 6, "name": "SSH", "type": "port", "hostname": "10.0.0.5", "port": 22, "interval": 60, "maxretries": 0,
     "active": true, "upsideDown": false},
    {"id": 7, "name": "Telnet closed", "type": "port", "hostname": "10.0.0.5", "port": 23, "interval": 300,
     "upsideDown": true, "active": true},
    {"id": 8, "name": "Gateway", "type": "ping", "hostname": "10.0.0.1", "interval": 10, "maxretries": 3,
     "active": true, "packetSize": 56},
    {"id": 9, "name": "MX record", "type": "dns", "hostname": "example.com", "dns_resolve_type": "MX",
     "dns_resolve_server": "1.1.1.1,8.8.8.8", "port": 53, "interval": 600, "active": true},
    {"id": 10, "name": "Nightly backup", "type": "push", "pushToken": "kumaPushTok", "interval": 86400,
     "active": true},
    {"id": 11, "name": "Containers", "type": "group", "interval": 60, "active": true},
    {"id": 12, "name": "Redis container", "type": "docker", "docker_container": "redis", "interval": 60, "active": true},
    {"id": 13, "name": "Broken URL", "type": "http", "url": "ftp://files.example.com", "interval": 60, "active": true},
    {"id": 14, "name": "Website", "type": "ping", "hostname": "www.example.com", "interval": 60, "active": true}
  ]
}
