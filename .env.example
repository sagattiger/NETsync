# Copy to .env and change the secrets:  cp .env.example .env
POSTGRES_PASSWORD=change-me-db-password
NETSYNC_SECRET_KEY=change-me-long-random-string

# URL users open NETsync on (used in notification links)
NETSYNC_PUBLIC_URL=http://netsync.local:8080
HTTP_PORT=8080

# Node name (matters later in cluster mode)
NETSYNC_NODE_NAME=node1

# Polling
NETSYNC_POLL_INTERVAL=300
NETSYNC_DISCOVERY_INTERVAL=21600
NETSYNC_POLL_CONCURRENCY=64

# Email notifications
NETSYNC_SMTP_HOST=
NETSYNC_SMTP_PORT=587
NETSYNC_SMTP_USER=
NETSYNC_SMTP_PASSWORD=
NETSYNC_SMTP_FROM=netsync@example.com

# Comma separated plugin names to disable, e.g. latency,syslog
NETSYNC_DISABLED_PLUGINS=
